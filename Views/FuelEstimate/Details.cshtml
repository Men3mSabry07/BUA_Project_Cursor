@model BUA_project.Models.FuelEstimate

@{
    ViewData["Title"] = "Fuel Estimate Details";
}

<div class="container mt-4">

    <h1 class="mb-4">Fuel Estimate</h1>

    <div class="card">

        <div class="card-header">
            <h4>
                Reservation #@Model.ReservationId
            </h4>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-5">
                    Vehicle
                </dt>

                <dd class="col-sm-7">
                    @Model.Reservation?.Vehicle?.Brand
                    @Model.Reservation?.Vehicle?.Model
                </dd>


                <dt class="col-sm-5">
                    Vehicle Type
                </dt>

                <dd class="col-sm-7">
                    @Model.Reservation?.Vehicle?.Type
                </dd>


                <dt class="col-sm-5">
                    Passengers
                </dt>

                <dd class="col-sm-7">
                    @Model.Reservation?.Passengers
                </dd>


                <dt class="col-sm-5">
                    Predicted Fuel
                </dt>

                <dd class="col-sm-7">

                    <strong>
                        @Model.PredictedFuel.ToString("0.00") Liters
                    </strong>

                </dd>


                <dt class="col-sm-5">
                    Fuel Price
                </dt>

                <dd class="col-sm-7">
                    @Model.FuelPricePerLiter.ToString("0.00")
                    EGP / Liter
                </dd>


                <dt class="col-sm-5">
                    Estimated Cost
                </dt>

                <dd class="col-sm-7">

                    <strong>
                        @Model.EstimatedCost.ToString("0.00") EGP
                    </strong>

                </dd>


                <dt class="col-sm-5">
                    Prediction Model
                </dt>

                <dd class="col-sm-7">
                    @Model.Model
                </dd>


                <dt class="col-sm-5">
                    Features Used
                </dt>

                <dd class="col-sm-7">
                    @Model.Features
                </dd>

            </dl>

            <hr />

            <div class="mt-3">

                <a asp-controller="Reservation"
                   asp-action="Details"
                   asp-route-id="@Model.ReservationId"
                   class="btn btn-secondary">
                    Back to Reservation
                </a>

                <a asp-action="Index"
                   class="btn btn-primary">
                    All Fuel Estimates
                </a>

            </div>

        </div>

    </div>

</div>