@model BUA_project.Models.RouteEstimate

@{
    ViewData["Title"] = "Delete Route Estimate";
}

<h1>Delete Route Estimate</h1>

@if (Model.Trip != null)
{
<div class="alert alert-warning">
    This Route Estimate is currently assigned
    to Trip #@Model.Trip.TripId.
</div>
}

<h4>Are you sure you want to delete this route estimate?</h4>

<dl class="row">

    <dt class="col-sm-3">
        Route Estimate ID
    </dt>

    <dd class="col-sm-9">
        @Model.RouteEstimateId
    </dd>


    <dt class="col-sm-3">
        Origin
    </dt>

    <dd class="col-sm-9">
        @Model.Origin
    </dd>


    <dt class="col-sm-3">
        Destination
    </dt>

    <dd class="col-sm-9">
        @Model.Destination
    </dd>


    <dt class="col-sm-3">
        Distance
    </dt>

    <dd class="col-sm-9">
        @Model.Distance km
    </dd>


    <dt class="col-sm-3">
        Duration
    </dt>

    <dd class="col-sm-9">
        @Model.Duration
    </dd>


    <dt class="col-sm-3">
        Provider Snapshot
    </dt>

    <dd class="col-sm-9">
        @Model.ProviderSnapshot
    </dd>

</dl>


<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="RouteEstimateId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>