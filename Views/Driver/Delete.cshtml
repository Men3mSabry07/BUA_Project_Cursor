@model BUA_project.Models.Driver

@{
    ViewData["Title"] = "Delete Driver";
}

<h1>Delete Driver</h1>

<h3>
    Are you sure you want to delete this driver?
</h3>

<div>

    <dl class="row">

        <dt class="col-sm-3">
            Name
        </dt>

        <dd class="col-sm-9">
            @Model.Name
        </dd>


        <dt class="col-sm-3">
            License Number
        </dt>

        <dd class="col-sm-9">
            @Model.LicenseNumber
        </dd>


        <dt class="col-sm-3">
            Qualification Status
        </dt>

        <dd class="col-sm-9">
            @Model.QualificationStatus
        </dd>


        <dt class="col-sm-3">
            Qualification Valid Until
        </dt>

        <dd class="col-sm-9">
            @Model.QualificationValidUntil
            .ToString("yyyy-MM-dd")
        </dd>


        <dt class="col-sm-3">
            User
        </dt>

        <dd class="col-sm-9">
            @Model.User?.Name
        </dd>

    </dl>


    <form asp-action="Delete"
          method="post">

        <input type="hidden"
               asp-for="DriverId" />

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
               class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>