@model BUA_project.Models.Driver

@{
    ViewData["Title"] = "Driver Details";
}

<h1>Driver Details</h1>

<div>

    <dl class="row">

        <dt class="col-sm-3">
            Driver ID
        </dt>

        <dd class="col-sm-9">
            @Model.DriverId
        </dd>


        <dt class="col-sm-3">
            Name
        </dt>

        <dd class="col-sm-9">
            @Model.Name
        </dd>


        <dt class="col-sm-3">
            License Number
        </dt>

        <dd class="col-sm-9">
            @Model.LicenseNumber
        </dd>


        <dt class="col-sm-3">
            Qualification Status
        </dt>

        <dd class="col-sm-9">
            @Model.QualificationStatus
        </dd>


        <dt class="col-sm-3">
            Qualification Valid Until
        </dt>

        <dd class="col-sm-9">
            @Model.QualificationValidUntil
            .ToString("yyyy-MM-dd")
        </dd>


        <dt class="col-sm-3">
            User
        </dt>

        <dd class="col-sm-9">
            @Model.User?.Name
        </dd>

    </dl>

</div>

<div>

    <a asp-action="Edit"
           asp-route-id="@Model.DriverId"
           class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back
    </a>

</div>