@model Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h1>Delete Vehicle</h1>

<h3>Are you sure you want to delete this vehicle?</h3>

<div>

    <dl class="row">

        <dt class="col-sm-3">
            Plate Number
        </dt>

        <dd class="col-sm-9">
            @Model.PlateNumber
        </dd>


        <dt class="col-sm-3">
            Brand
        </dt>

        <dd class="col-sm-9">
            @Model.Brand
        </dd>


        <dt class="col-sm-3">
            Model
        </dt>

        <dd class="col-sm-9">
            @Model.Model
        </dd>


        <dt class="col-sm-3">
            Type
        </dt>

        <dd class="col-sm-9">
            @Model.Type
        </dd>


        <dt class="col-sm-3">
            Status
        </dt>

        <dd class="col-sm-9">
            @Model.Status
        </dd>

    </dl>


    <form asp-action="Delete" method="post">

        <input type="hidden"
               asp-for="VehicleId" />

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
               class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>