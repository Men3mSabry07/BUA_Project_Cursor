@model Vehicle

@{
    ViewData["Title"] = "Edit Vehicle";
}

<h1>Edit Vehicle</h1>

<form asp-action="Edit" method="post">

    <input type="hidden"
           asp-for="VehicleId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>


    <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        <input asp-for="Type" class="form-control" />
        <span asp-validation-for="Type"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="Seats" class="form-label"></label>
        <input asp-for="Seats"
               type="number"
               class="form-control" />

        <span asp-validation-for="Seats"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="FuelType" class="form-label"></label>
        <input asp-for="FuelType" class="form-control" />

        <span asp-validation-for="FuelType"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="PlateNumber" class="form-label"></label>
        <input asp-for="PlateNumber"
               class="form-control" />

        <span asp-validation-for="PlateNumber"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <input asp-for="Status" class="form-control" />

        <span asp-validation-for="Status"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year"
               type="number"
               class="form-control" />

        <span asp-validation-for="Year"
              class="text-danger"></span>
    </div>


    <div class="mb-3">

        <label asp-for="VehicleSpecificationId"
               class="form-label">
            Vehicle Specification
        </label>

        <select asp-for="VehicleSpecificationId"
                class="form-select">

            <option value="">
                -- Select Specification --
            </option>

            @foreach (var specification in ViewBag.VehicleSpecifications)
            {
                <option value="@specification.VehicleSpecificationId">
                    @specification.VehicleSpecificationId
                </option>
            }

        </select>

        <span asp-validation-for="VehicleSpecificationId"
              class="text-danger"></span>

    </div>


    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back
    </a>

</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}