@model BUA_project.Models.LocationPing

@{
    ViewData["Title"] = "Edit Location Ping";
}

<h1>Edit Location Ping</h1>

<form asp-action="Edit" method="post">

    <input type="hidden"
           asp-for="LocationPingId" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>


    <div class="mb-3">

        <label asp-for="Latitude"
               class="form-label">
            Latitude
        </label>

        <input asp-for="Latitude"
               type="number"
               step="any"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="Longitude"
               class="form-label">
            Longitude
        </label>

        <input asp-for="Longitude"
               type="number"
               step="any"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="Timestamp"
               class="form-label">
            Timestamp
        </label>

        <input asp-for="Timestamp"
               type="datetime-local"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="TripId"
               class="form-label">
            Trip
        </label>

        <select asp-for="TripId"
                class="form-select">

            @foreach (var trip in ViewBag.Trips)
            {
                <option value="@trip.TripId">
                    Trip #@trip.TripId
                </option>
            }

        </select>

    </div>


    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back
    </a>

</form>