@model BUA_project.Models.Trip

@{
    ViewData["Title"] = "Create Trip";
}

<h1>Create Trip</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>


    <div class="mb-3">

        <label asp-for="StartedAt"
               class="form-label">
        </label>

        <input asp-for="StartedAt"
               type="datetime-local"
               class="form-control" />

        <span asp-validation-for="StartedAt"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="StartOdometer"
               class="form-label">
        </label>

        <input asp-for="StartOdometer"
               type="number"
               step="0.01"
               class="form-control" />

        <span asp-validation-for="StartOdometer"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="Status"
               class="form-label">
        </label>

        <select asp-for="Status"
                class="form-select">

            <option value="Scheduled">
                Scheduled
            </option>

            <option value="InProgress">
                In Progress
            </option>

            <option value="Completed">
                Completed
            </option>

        </select>

        <span asp-validation-for="Status"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="ReservationId"
               class="form-label">
            Reservation
        </label>

        <select asp-for="ReservationId"
                class="form-select">

            <option value="">
                -- Select Reservation --
            </option>

            @foreach (var reservation in ViewBag.Reservations)
            {
                <option value="@reservation.ReservationId">

                    #@reservation.ReservationId -
                    @reservation.Origin →
                    @reservation.Destination

                </option>
            }

        </select>

        <span asp-validation-for="ReservationId"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="RouteEstimateId"
               class="form-label">
            Route Estimate
        </label>

        <select asp-for="RouteEstimateId"
                class="form-select">

            <option value="">
                -- Select Route Estimate --
            </option>

            @foreach (var route in ViewBag.RouteEstimates)
            {
                <option value="@route.RouteEstimateId">
                    @route.RouteEstimateId
                </option>
            }

        </select>

        <span asp-validation-for="RouteEstimateId"
              class="text-danger">
        </span>

    </div>


    <button type="submit"
            class="btn btn-primary">
        Create
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back
    </a>

</form>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}