@model BUA_project.Models.Trip

@{
    ViewData["Title"] = "Trip Details";
}

<h1>Trip Details</h1>

<dl class="row">

    <dt class="col-sm-3">
        Trip ID
    </dt>

    <dd class="col-sm-9">
        @Model.TripId
    </dd>


    <dt class="col-sm-3">
        Reservation
    </dt>

    <dd class="col-sm-9">
        #@Model.ReservationId
    </dd>


    <dt class="col-sm-3">
        Route
    </dt>

    <dd class="col-sm-9">

        @Model.Reservation?.Origin
        →
        @Model.Reservation?.Destination

    </dd>


    <dt class="col-sm-3">
        Vehicle
    </dt>

    <dd class="col-sm-9">
        @Model.Reservation?.Vehicle?.PlateNumber
    </dd>


    <dt class="col-sm-3">
        Started At
    </dt>

    <dd class="col-sm-9">
        @Model.StartedAt
    </dd>


    <dt class="col-sm-3">
        Completed At
    </dt>

    <dd class="col-sm-9">
        @Model.CompletedAt
    </dd>


    <dt class="col-sm-3">
        Start Odometer
    </dt>

    <dd class="col-sm-9">
        @Model.StartOdometer
    </dd>


    <dt class="col-sm-3">
        End Odometer
    </dt>

    <dd class="col-sm-9">
        @Model.EndOdometer
    </dd>


    <dt class="col-sm-3">
        Actual Distance
    </dt>

    <dd class="col-sm-9">
        @Model.ActualDistanceKm km
    </dd>


    <dt class="col-sm-3">
        Actual Fuel
    </dt>

    <dd class="col-sm-9">
        @Model.ActualFuelLiters L
    </dd>


    <dt class="col-sm-3">
        Actual Fuel Cost
    </dt>

    <dd class="col-sm-9">
        @Model.ActualFuelCost
    </dd>


    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>


    <dt class="col-sm-3">
        Incident Notes
    </dt>

    <dd class="col-sm-9">
        @Model.IncidentNotes
    </dd>

</dl>

<a asp-action="Edit"
       asp-route-id="@Model.TripId"
       class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
       class="btn btn-secondary">
    Back
</a>