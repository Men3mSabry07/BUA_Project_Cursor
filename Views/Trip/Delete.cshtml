@model BUA_project.Models.Trip

@{
    ViewData["Title"] = "Delete Trip";
}

<h1>Delete Trip</h1>

<h3>
    Are you sure you want to delete this trip?
</h3>

<dl class="row">

    <dt class="col-sm-3">
        Trip ID
    </dt>

    <dd class="col-sm-9">
        @Model.TripId
    </dd>


    <dt class="col-sm-3">
        Reservation
    </dt>

    <dd class="col-sm-9">
        #@Model.ReservationId
    </dd>


    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>


    <dt class="col-sm-3">
        Started At
    </dt>

    <dd class="col-sm-9">
        @Model.StartedAt
    </dd>

</dl>


<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="TripId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Cancel
    </a>

</form>