@model BUA_project.Models.Trip

@{
    ViewData["Title"] = "Edit Trip";
}

<h1>Edit Trip</h1>

<form asp-action="Edit" method="post">

    <input type="hidden"
           asp-for="TripId" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>


    <div class="mb-3">

        <label asp-for="StartedAt"
               class="form-label">
        </label>

        <input asp-for="StartedAt"
               type="datetime-local"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="CompletedAt"
               class="form-label">
        </label>

        <input asp-for="CompletedAt"
               type="datetime-local"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="ActualDistanceKm"
               class="form-label">
        </label>

        <input asp-for="ActualDistanceKm"
               type="number"
               step="0.01"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="ActualFuelLiters"
               class="form-label">
        </label>

        <input asp-for="ActualFuelLiters"
               type="number"
               step="0.01"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="ActualFuelCost"
               class="form-label">
        </label>

        <input asp-for="ActualFuelCost"
               type="number"
               step="0.01"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="StartOdometer"
               class="form-label">
        </label>

        <input asp-for="StartOdometer"
               type="number"
               step="0.01"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="EndOdometer"
               class="form-label">
        </label>

        <input asp-for="EndOdometer"
               type="number"
               step="0.01"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="IncidentNotes"
               class="form-label">
        </label>

        <textarea asp-for="IncidentNotes"
                      class="form-control">
        </textarea>

        </div>


        <div class="mb-3">

            <label asp-for="Status"
                   class="form-label">
            </label>

            <select asp-for="Status"
                    class="form-select">

                <option value="Scheduled">
                    Scheduled
                </option>

                <option value="InProgress">
                    In Progress
                </option>

                <option value="Completed">
                    Completed
                </option>

                <option value="Cancelled">
                    Cancelled
                </option>

            </select>

        </div>


        <div class="mb-3">

            <label asp-for="ReservationId"
                   class="form-label">
                Reservation
            </label>

            <select asp-for="ReservationId"
                    class="form-select">

                @foreach (var reservation in ViewBag.Reservations)
                {
                    <option value="@reservation.ReservationId">

                        #@reservation.ReservationId -
                        @reservation.Origin →
                        @reservation.Destination

                    </option>
                }

            </select>

        </div>


        <div class="mb-3">

            <label asp-for="RouteEstimateId"
                   class="form-label">
                Route Estimate
            </label>

            <select asp-for="RouteEstimateId"
                    class="form-select">

                <option value="">
                    -- None --
                </option>

                @foreach (var route in ViewBag.RouteEstimates)
                {
                    <option value="@route.RouteEstimateId">
                        @route.RouteEstimateId
                    </option>
                }

            </select>

        </div>


        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index"
               class="btn btn-secondary">
            Back
        </a>

    </form>