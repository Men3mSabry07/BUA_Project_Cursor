@model IEnumerable<BUA_project.Models.User>

    @{
    ViewData["Title"] = "Users";
    }

    <h1>Users</h1>

    <p>
        <a asp-action="Create"
           class="btn btn-primary">
            Create New User
        </a>
    </p>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>
                    Name
                </th>

                <th>
                    Email
                </th>

                <th>
                    Role
                </th>

                <th>
                    Actions
                </th>
            </tr>
        </thead>

        <tbody>

            @foreach (var user in Model)
        {
            <tr>

                <td>
                    @user.Name
                </td>

                <td>
                    @user.Email
                </td>

                <td>
                    @user.Role
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@user.UserId"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@user.UserId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@user.UserId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </td>

            </tr>
        }

        </tbody>

    </table>
