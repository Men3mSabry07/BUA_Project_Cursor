@model BUA_project.Models.Reservation

@{
    ViewData["Title"] = "Approve Reservation";
}

<h1>Approve Reservation</h1>

<h4>
    Are you sure you want to approve this reservation?
</h4>

<div class="mb-3">

    <strong>Requester:</strong>
    @Model.User?.Name

</div>

<div class="mb-3">

    <strong>Vehicle:</strong>
    @Model.Vehicle?.PlateNumber

</div>

<div class="mb-3">

    <strong>Route:</strong>
    @Model.Origin
    →
    @Model.Destination

</div>

<div class="mb-3">

    <strong>Start:</strong>
    @Model.StartDateTime

</div>

<div class="mb-3">

    <strong>End:</strong>
    @Model.EndDateTime

</div>


<form asp-action="Approve"
      method="post">

    <input type="hidden"
           name="id"
           value="@Model.ReservationId" />

    <button type="submit"
            class="btn btn-success">
        Approve
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Cancel
    </a>

</form>